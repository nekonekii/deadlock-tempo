<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Deadlock Tempo — панель управления" Width="1080" Height="820" MinWidth="820" MinHeight="620" WindowStartupLocation="CenterScreen">
  <Grid Margin="28,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="TEMPO / DEADLOCK" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock Text="Держи город под контролем." FontFamily="{DynamicResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
      <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="7" Padding="14,9" VerticalAlignment="Center"><TextBlock Text="ВНЕШНИЙ ОВЕРЛЕЙ  /  v1.13.3" FontSize="11" Foreground="{StaticResource Muted}"/></Border>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="22" Margin="0,0,0,18">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="ClockState" Text="МАТЧ НЕ НАЧАТ" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ClockText" Text="00:00" FontFamily="Consolas" FontSize="48" Foreground="{StaticResource Accent}" Margin="0,3,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,14,0"><TextBlock Text="Время на часах игры" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,7"/><StackPanel Orientation="Horizontal"><TextBox x:Name="SyncTime" Text="00:00" Width="82" FontFamily="Consolas" AutomationProperties.Name="Время матча, минуты и секунды"/><Button x:Name="Sync" Content="Синхронизировать" Margin="8,0,0,0" Padding="12,8"/></StackPanel><TextBlock Text="Ручная настройка отключает автоопределение." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center"><Button x:Name="Start" Content="Начать матч" Style="{StaticResource Primary}" MinWidth="158"/><Button x:Name="Reset" Content="Сбросить матч" Margin="0,8,0,0" Padding="12,8"/></StackPanel>
      </Grid>
    </Border>
    <TabControl x:Name="Tabs" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0,16,0,0">
      <TabItem Header="Обзор"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,22,0"><StackPanel><Border Background="{StaticResource Panel}" Padding="15" Margin="0,0,0,14"><StackPanel><CheckBox x:Name="AutoVision" Content="Автоопределение по экрану" FontWeight="SemiBold"/><TextBlock x:Name="VisionDetail" Text="Вернитесь в Deadlock: ожидаю часы, счёт команд и миникарту." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/><TextBlock Text="Кадры обрабатываются локально и не сохраняются." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border><TextBlock Text="БЛИЖАЙШИЕ СОБЫТИЯ" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/><StackPanel x:Name="Upcoming"/><TextBlock Text="Чаша появляется по расписанию. Разлом: первое примерное окно и напоминания проверить карту. Для лагерей — только первое появление; респаун не отслеживается." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,12"/></StackPanel></ScrollViewer>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="Предупреждения в игре" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="OverlayModeHint" Text="Маленькие значки возле курсора или прицела." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,9,0,15"/><Button x:Name="ToggleOverlay" Content="Скрыть оверлей"/><Button x:Name="MoveOverlay" Content="Настроить текст" Margin="0,8,0,0"/><Button x:Name="HidePanel" Content="Убрать панель управления" Margin="0,8,0,0"/><TextBlock Text="Вернуть панель: Ctrl + Alt + F10" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,10,0,0"/></StackPanel></Border>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,0"><StackPanel><TextBlock Text="Горячие клавиши" FontWeight="SemiBold"/><TextBlock Text="Ctrl + Alt + F8     Старт / пауза&#x0a;Ctrl + Alt + F9     Показать / скрыть&#x0a;Ctrl + Alt + F10   Панель управления" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="24" Margin="0,8,0,0"/><TextBlock x:Name="HotkeyStatus" FontSize="11" Foreground="#FFC98B" Margin="0,8,0,0"/></StackPanel></Border>
          <TextBlock Text="Часы синхронизируются по изображению. При Alt+Tab захват прекращается; после возврата синхронизация восстанавливается." Foreground="{StaticResource Muted}" FontSize="12" Margin="2,14,2,0"/>
        </StackPanel></ScrollViewer>
      </Grid></TabItem>
      <TabItem Header="Расписание"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12"><TextBlock Text="Профиль событий" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ProfileCaption" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/><TextBlock Text="ММ:СС. Для разлома период задаёт напоминание проверить карту, а не время появления. Пустые поля «До» и «Период» означают одно появление." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel>
        <DataGrid x:Name="ScheduleGrid" Grid.Row="1" SelectionMode="Single" SelectionUnit="FullRow" CanUserSortColumns="False"><DataGrid.Columns>
          <DataGridCheckBoxColumn Header="Вкл." Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
          <DataGridTextColumn Header="Событие" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="210"/>
          <DataGridTextColumn Header="Первое" Binding="{Binding First, UpdateSourceTrigger=PropertyChanged}" Width="78"/>
          <DataGridTextColumn Header="До" Binding="{Binding Until, UpdateSourceTrigger=PropertyChanged}" Width="78"/>
          <DataGridTextColumn Header="Период" Binding="{Binding Every, UpdateSourceTrigger=PropertyChanged}" Width="78"/>
        </DataGrid.Columns></DataGrid>
        <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="EventNote" Foreground="{StaticResource Muted}" FontSize="12" MinHeight="35"/><TextBlock x:Name="ProfileError" Foreground="#FFC98B" FontSize="12" Margin="0,5,0,6"/><WrapPanel><Button x:Name="ApplyProfile" Content="Сохранить расписание" Style="{StaticResource Primary}"/><Button x:Name="AddEvent" Content="Добавить событие" Margin="8,0,0,0"/><Button x:Name="Defaults" Content="Исходный профиль" Margin="8,0,0,0"/></WrapPanel></StackPanel>
      </Grid></TabItem>
      <TabItem Header="Настройки"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="710" HorizontalAlignment="Left">
        <TextBlock Text="Предупреждения сверху по центру" FontSize="20" FontWeight="SemiBold"/>
        <CheckBox x:Name="CursorMode" Content="Крупный текст вместо сводной панели" Margin="0,16,0,0"/>
        <CheckBox x:Name="AutoStartGame" Content="Автоматически запускать Tempo вместе с Deadlock" Margin="0,12,0,0"/>
        <TextBlock Text="Название события и обратный отсчёт крупным шрифтом Deadlock. Предупреждение появляется за 30 секунд: жёлтый цвет на 20 секунд, красный на последние 10. Затем надпись «ВРЕМЯ ПРИШЛО» остаётся на 10 секунд. Одновременные события показаны отдельными строками." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,12,0,0"/>
        <TextBlock Text="Текст остаётся неподвижным, а световые контуры вокруг него плавно повторяются и выделяют смену этапа. При выключенных анимациях Windows оформление статично. Между предупреждениями крупный текст скрыт; маленький статус TEMPO справа сверху остаётся." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,10,0,0"/>
        <TextBlock Text="Размер текста · для высоты экрана 1440 px" Margin="0,22,0,8"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><Slider x:Name="BannerTextSize" Minimum="32" Maximum="64" TickFrequency="2" IsSnapToTickEnabled="True" AutomationProperties.Name="Размер текста предупреждения"/><TextBlock x:Name="BannerTextSizeValue" Grid.Column="1" Margin="14,0,0,0"/></Grid>
        <TextBlock Text="Непрозрачность текста" Margin="0,18,0,8"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><Slider x:Name="BannerOpacity" Minimum="0.7" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="Непрозрачность предупреждения"/><TextBlock x:Name="BannerOpacityValue" Grid.Column="1" Margin="14,0,0,0"/></Grid>
        <TextBlock Text="Отступ от верхнего края игры" Margin="0,18,0,8"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><Slider x:Name="BannerTop" Minimum="15" Maximum="25" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Отступ предупреждения сверху"/><TextBlock x:Name="BannerTopValue" Grid.Column="1" Margin="14,0,0,0"/></Grid>
        <TextBlock Text="По горизонтали текст всегда в центре игрового окна. Отступ оставляет место верхнему счёту команд. Размер адаптируется к разрешению; мышь не влияет на положение." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/>
        <Button x:Name="PreviewCursor" Content="Показать пример · 40 секунд" HorizontalAlignment="Left" Margin="0,18,0,0"/>
        <TextBlock Text="Пример показывается, пока открыта панель Tempo, и не меняет часы игры. Ctrl + Alt + F10 — открыть или скрыть панель. Закрытие панели крестиком оставляет оверлей работающим." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>

        <TextBlock Text="Большая панель" FontSize="20" FontWeight="SemiBold" Margin="0,26,0,0"/>
        <TextBlock Text="Масштаб панели" Margin="0,16,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><Slider x:Name="Scale" Minimum="0.8" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="Масштаб оверлея"/><TextBlock x:Name="ScaleValue" Grid.Column="1" Margin="14,0,0,0"/></Grid>
        <TextBlock Text="Непрозрачность фона" Margin="0,20,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><Slider x:Name="Opacity" Minimum="0.6" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="Непрозрачность фона оверлея"/><TextBlock x:Name="OpacityValue" Grid.Column="1" Margin="14,0,0,0"/></Grid>
        <CheckBox x:Name="Sound" Content="Короткий звук за 30 секунд до события" Margin="0,20,0,0"/>
        <TextBlock Text="Положение на экране" Margin="0,22,0,8"/><WrapPanel><Button x:Name="PosLeft" Content="Слева"/><Button x:Name="PosRight" Content="Справа" Margin="8,0,0,0"/><Button x:Name="PosCenter" Content="По центру" Margin="8,0,0,0"/><Button x:Name="NextScreen" Content="Другой монитор" Margin="8,0,0,0"/></WrapPanel>
        <TextBlock Text="Кнопки перемещают оверлей на выбранном мониторе. Для точного положения включите режим перемещения и перетащите панель мышью; после фиксации клики снова проходят в игру." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
        <TextBlock Text="Быстрая поправка часов" Margin="0,22,0,8"/><WrapPanel><Button x:Name="Minus" Content="−1 секунда"/><Button x:Name="Plus" Content="+1 секунда" Margin="8,0,0,0"/></WrapPanel>
        <TextBlock Text="Настройки сохраняются автоматически. Матч при каждом запуске начинается с остановленных часов 00:00." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,22,0,12"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="О приложении"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="780" HorizontalAlignment="Left">
        <TextBlock Text="Отдельное окно Windows" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock Text="Tempo считывает видимые пиксели активного окна Deadlock и распознаёт часы локальным Windows OCR. Старт подтверждается несколькими кадрами, счётом команд и миникартой; финиш — заголовком результата и кнопкой повторной игры. Захват не сохраняется и никуда не отправляется. Приложение не читает память, логи или трафик и не управляет игрой." Foreground="{StaticResource Muted}" Margin="0,12,0,0" LineHeight="23"/>
        <TextBlock Text="Оверлей использует стандартное прозрачное окно Windows. Глобальные сочетания клавиш зарегистрированы через RegisterHotKey; перехватчики клавиатуры, драйверы и внедрение DLL не используются." Foreground="{StaticResource Muted}" Margin="0,12,0,0" LineHeight="23"/>
        <TextBlock Text="Гарантировать отсутствие реакции античита невозможно. Это приложение не одобрено Valve и не скрывает своё присутствие." Foreground="#FFC98B" Margin="0,12,0,0" LineHeight="23"/>
        <TextBlock Text="Распознавание и расписание" FontSize="19" FontWeight="SemiBold" Margin="0,26,0,0"/>
        <TextBlock Text="Профиль распознавания проверен на вашем экране 3440×1440; области масштабируются по высоте окна. После обновлений HUD распознавание может потребовать настройки. При потере изображения часы через 3 секунды останавливаются до восстановления. Ручной режим всегда доступен. Для оформления используются установленные шрифты Valve Pulp / Oracle; при их отсутствии — системные. Встроенный профиль основан на справочных данных City Never Sleeps от 3 октября 2026 года. Источники просмотрены 16 октября. Совпадение с вашей версией игры не проверено. После патчей сверяйте и меняйте расписание на соответствующей вкладке. Sandbox и Explore NYC используют другое расписание." Foreground="{StaticResource Muted}" Margin="0,10,0,0" LineHeight="23"/>
        <TextBlock Text="В расписании семь событий: малые, средние и крупные лагеря, обычные коробки, руны, автоматы и разлом. Для лагерей показано только первое появление. Разлом повторяется, но здесь показано только примерное первое окно: точный следующий спавн пока не распознаётся. В публикациях Valve указан интервал 7 минут со случайным смещением ±1 минута и предупреждение за 20 секунд; проверено 17.10.2026." Foreground="{StaticResource Muted}" Margin="0,10,0,0" LineHeight="23"/>
        <TextBlock Text="Источники (открываются в браузере)" FontWeight="SemiBold" Margin="0,22,0,8"/><WrapPanel><Button x:Name="SourceResearch" Content="Исследование таймингов"/><Button x:Name="SourceCrates" Content="Deadlock Wiki · Crates" Margin="8,0,0,0"/></WrapPanel>
        <TextBlock x:Name="DataLocation" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,22,0,16"/>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,16,0,0"><TextBlock x:Name="Status" Text="Готово. Вернитесь в игру — часы определятся автоматически." FontSize="12" Foreground="{StaticResource Muted}"/></Border>
  </Grid>
</Window>
