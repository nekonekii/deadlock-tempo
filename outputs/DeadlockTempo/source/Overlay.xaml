<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Deadlock Tempo — оверлей" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False">
  <Border x:Name="OverlayCard" Width="356" CornerRadius="2" BorderBrush="#9B8251" BorderThickness="1,3,1,1" Padding="16,13">
    <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="TEMPO" FontFamily="{DynamicResource DisplayFont}" Foreground="{StaticResource Accent}" FontSize="25" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="OverlayClock" Grid.Column="1" FontFamily="Consolas" FontSize="30" Text="00:00"/></Grid>
      <TextBlock x:Name="OverlayState" FontSize="10" Foreground="{StaticResource Muted}" Text="ОЖИДАНИЕ МАТЧА" Margin="0,5,0,13"/>
      <Border Height="1" Background="#63563C" Margin="0,0,0,0"/>
      <StackPanel x:Name="OverlayEvents"/>
      <TextBlock x:Name="OverlayMore" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
      <TextBlock x:Name="OverlayFooter" Text="30 СЕК · ЖЁЛТЫЙ / 10 СЕК · КРАСНЫЙ" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
    </StackPanel>
  </Border>
</Window>
